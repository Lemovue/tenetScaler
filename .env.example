# Copy to .env and fill in only what you need. Every variable is optional;
# no key is needed to run anything (without llama.cpp the demo falls back to
# the SIMULATED engine and says so). Real environment variables override
# values from .env.

# --- Real inference (llama.cpp) ---
# Written by scripts/setup-llama.ps1; leave empty to use the simulated engine.
TS_LLAMA_SERVER=
TS_LLAMA_MODEL=
# Download cache for scripts/setup-llama.ps1 (default: .cache in this folder)
TS_CACHE_DIR=

# --- Demo / dashboard ---
# Dashboard + API listen address
TS_DEMO_ADDR=127.0.0.1:8080

# --- Optional: point a gateway at another OpenAI-compatible server ---
# (vLLM, llama.cpp server, Ollama /v1): comma-separated base URLs.
TS_UPSTREAM_ENDPOINTS=
# Sent as "Authorization: Bearer <value>" to the upstream when set.
TS_UPSTREAM_API_KEY=

# --- Live multi-laptop demo (tenantscaler demo -live 0.0.0.0:8081) ---
# One key per tenant, optionally capped at a priority: tenant[:maxPriority]=key,
# comma-separated, keys of at least 16 characters, e.g.
# TS_TENANT_KEYS=A:standard=<long random key>,B:standard=<...>,C:sheddable=<...>
# Never commit real keys; hand each teammate only their own.
TS_TENANT_KEYS=
# Admin key for the standalone gateway's /policy, /stats and /metrics (optional)
TS_ADMIN_KEY=
# On a teammate's laptop: their tenant key for `tenantscaler loadgen -gateway`
TS_API_KEY=

# --- Optional: Kubernetes mode (controller and gateway) ---
# Empty kubeconfig = in-cluster config; empty namespace = the pod's own
TS_KUBECONFIG=
TS_NAMESPACE=
